# PostgreSQL / Docker
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/revenue_recovery
REDIS_URL=redis://localhost:6379/0

# Groq / Strands
GROQ_API_KEY=replace-with-your-groq-key

# Razorpay
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
